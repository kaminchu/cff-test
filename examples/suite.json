    {
      "name": "Normalize query string parameters",
      "function": "normalize-query-string-parameters.js",
      "cases": [
        {
          "name": "sorts parameters and multiple values",
          "event": {
            "version": "1.0",
            "context": { "eventType": "viewer-request" },
            "viewer": { "ip": "198.51.100.11" },
            "request": {
              "method": "GET",
              "uri": "/search",
              "querystring": {
                "z": { "value": "last" },
                "a": {
                  "value": "b",
                  "multiValue": [
                    { "value": "b" },
                    { "value": "a" }
                  ]
                }
              },
              "headers": { "host": { "value": "example.com" } },
              "cookies": {}
            }
          },
          "expected": {
            "method": "GET",
            "uri": "/search",
            "querystring": "a=a&a=b&z=last",
            "headers": { "host": { "value": "example.com" } },
            "cookies": {}
          }
        }
      ]
    },
    {
      "name": "Redirect to a new URL",
      "function": "redirect-based-on-country.js",
      "cases": [
        {
          "name": "redirects viewers in Germany",
          "event": {
            "version": "1.0",
            "context": { "eventType": "viewer-request" },
            "viewer": { "ip": "198.51.100.11" },
            "request": {
              "method": "GET",
              "uri": "/",
              "querystring": {},
              "headers": {
                "host": { "value": "example.com" },
                "cloudfront-viewer-country": { "value": "DE" }
              },
              "cookies": {}
            }
          },
          "expected": {
            "statusCode": 302,
            "statusDescription": "Found",
            "headers": {
              "location": { "value": "https://example.com/de/index.html" }
            }
          }
        }
      ]
    },
