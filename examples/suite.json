{
  "functions": [
    {
      "name": "Add HTTP security headers",
      "function": "add-security-headers.js",
      "cases": [
        {
          "name": "adds security headers",
          "event": {
            "version": "1.0",
            "context": { "eventType": "viewer-response" },
            "viewer": { "ip": "198.51.100.11" },
            "request": {
              "method": "GET",
              "uri": "/index.html",
              "querystring": {},
              "headers": { "host": { "value": "example.com" } },
              "cookies": {}
            },
            "response": {
              "statusCode": 200,
              "statusDescription": "OK",
              "headers": { "content-type": { "value": "text/html" } },
              "cookies": {}
            }
          },
          "expected": {
            "statusCode": 200,
            "statusDescription": "OK",
            "headers": {
              "content-type": { "value": "text/html" },
              "strict-transport-security": { "value": "max-age=63072000; includeSubdomains; preload" },
              "content-security-policy": { "value": "default-src 'none'; img-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; frame-ancestors 'none'" },
              "x-content-type-options": { "value": "nosniff" },
              "x-frame-options": { "value": "DENY" },
              "x-xss-protection": { "value": "1; mode=block" },
              "referrer-policy": { "value": "same-origin" }
            },
            "cookies": {}
          }
        }
      ]
    },
    {
      "name": "Add a CORS header",
      "function": "add-cors-header.js",
      "cases": [
        {
          "name": "copies the request origin",
          "event": {
            "version": "1.0",
            "context": { "eventType": "viewer-response" },
            "viewer": { "ip": "198.51.100.11" },
            "request": {
              "method": "GET",
              "uri": "/api",
              "querystring": {},
              "headers": {
                "host": { "value": "example.com" },
                "origin": { "value": "https://client.example" }
              },
              "cookies": {}
            },
            "response": {
              "statusCode": 200,
              "statusDescription": "OK",
              "headers": { "content-type": { "value": "application/json" } },
              "cookies": {}
            }
          },
          "expected": {
            "statusCode": 200,
            "statusDescription": "OK",
            "headers": {
              "content-type": { "value": "application/json" },
              "access-control-allow-origin": { "value": "https://client.example" }
            },
            "cookies": {}
          }
        }
      ]
    },
    {
      "name": "Add a cache control header",
      "function": "add-cache-control-header.js",
      "cases": [
        {
          "name": "adds cache control to a successful response",
          "event": {
            "version": "1.0",
